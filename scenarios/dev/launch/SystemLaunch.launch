<?xml version="1.0"?>
<launch>
    <arg name="robot_namespace" value="/robot" />
    <arg name="verbosity_level" default="NOTICE"/>
    <arg name="topic_joystick_command" value ="joy"/>
    <arg name="topic_command_throttle" value="cmd_throttle"/> 
    <arg name="topic_left_drive" value ="left_drive"/>
    <arg name="topic_right_drive" value="right_drive"/>
    <arg name="device_hostname" default="$(env ROS_HOSTNAME)"/>

    <arg name="joy_calibration_config_file" value="$(find crawler_app)/scenarios/dev/DeviceConfig/ThrustmasterJoystick.yaml"/>

    <arg name="imu1_device_config_file" value="$(find crawler_app)/scenarios/dev/DeviceConfig/IMU_Sparkfun_183F.yaml"/>  
    <arg name="imu1_frame" value="base_link/raw_imu1"/>      
    <arg name="imu1_topic" value="raw_imu1"/>
    <arg name="imu1magnetometer_topic" value="raw_imu1_magnetometer"/>

    <arg name="imu2_device_config_file" value="$(find crawler_app)/scenarios/dev/DeviceConfig/IMU_Sparkfun_2115.yaml"/>
    <arg name="imu2_frame" value="base_link/raw_imu2"/>    
    <arg name="imu2_topic" value="raw_imu2"/>
    <arg name="imu2magnetometer_topic" value="raw_imu2_magnetometer"/>

    <arg name="imu3_device_config_file" value="$(find crawler_app)/scenarios/dev/DeviceConfig/IMU_RobotshopTM151_3435.yaml"/>
    <arg name="imu3_frame" value="base_link/raw_imu3"/>
    <arg name="imu3_topic" value="raw_imu3"/>
    <arg name="imu3magnetometer_topic" value="raw_imu3_magnetometer"/>
    
    <group ns="$(arg robot_namespace)">

        <group  if="$(eval device_hostname == 'DevComputer2')">
            <!--
            <node type="rviz" name="rviz" pkg="rviz" args="-d $(find crawler_app)/scenarios/dev/launch/rviz/rviz_config.rviz" />
            -->
            <node pkg="imu_transformer" type="imu_transformer_node" name="imu3_transformer" output="screen"> <!-- Have to run this on x86.  Create Follow-up-->
                <!-- Remap to your actual source IMU topic -->
                <remap from="imu_in/data" to="$(arg imu3_topic)"/>
                <remap from="imu_in/mag" to="$(arg imu3magnetometer_topic)"/>
                
                <!-- Remap to your desired output IMU topic -->
                <remap from="imu_out/data" to="imu3"/>
                <remap from="imu_out/mag" to="imu3_magnetometer"/>
                
                <!-- Target frame you want the data to be expressed in -->
                <param name="target_frame" value="base_link"/>
            </node>
             
            <node pkg="rqt_plot" type="rqt_plot" name="rqt_plot_rotate" args="/robot/imu3/angular_velocity/z /robot/cmd_throttle/angular/z" />
            <node pkg="rqt_plot" type="rqt_plot" name="rqt_plot_fwd" args="/robot/cmd_throttle/linear/x" />
           <!--
            <node pkg="rqt_plot" type="rqt_plot" name="rqt_plot_imu1" args="/robot/raw_imu1/linear_acceleration/x /robot/raw_imu1/linear_acceleration/y /robot/raw_imu1/linear_acceleration/z" />
            <node pkg="rqt_plot" type="rqt_plot" name="rqt_plot_imu2" args="/robot/raw_imu2/linear_acceleration/x /robot/raw_imu2/linear_acceleration/y /robot/raw_imu2/linear_acceleration/z" />
            
            <node pkg="rqt_plot" type="rqt_plot" name="rqt_plot_imu3" args="/robot/raw_imu3/linear_acceleration/x /robot/raw_imu3/linear_acceleration/y /robot/raw_imu3/linear_acceleration/z" />
            -->
            <node name="joy_node" pkg="joy" type="joy_node" output="screen" clear_params="true">
                <param name="autorepeat_rate" value="10.0"/>
            </node>
            <!--
            <node pkg="rosbag" type="record" name="recorder" output="screen" args="-a -o $(env HOME)/Documents/Logs/Bags/" />
            -->
        </group>
        <group  if="$(eval device_hostname == 'ComputeModule1')">
            <!-- Frames -->
            <node pkg="tf2_ros" type="static_transform_publisher" name="link1_broadcaster" args="0.0635 0.00635 0 0 3.14159 0 base_link $(arg imu3_frame)" />
            <include file="$(find robot_framework_ros)/Systems/UserInterface/Subsystems/RemoteControl/Nodes/TeleopControl/BasicTeleopControlNode/launch/basicTeleopControl_node.launch">
                <arg name="robot_namespace" value="$(arg robot_namespace)"/>
                <arg name="verbosity_level"       value="$(arg verbosity_level)"/>
                <arg name="joystick_calibration_config_file" value="$(arg joy_calibration_config_file)"/>
                <!-- Input Topics -->
                <arg name="topic_joystick_command" value ="$(arg topic_joystick_command)"/>
                <!-- Output Topics -->
                <arg name="topic_command_throttle" value="$(arg topic_command_throttle)"/> 
            </include>
            <include file="$(find robot_framework_ros)/Systems/Navigation/Subsystems/NavigationExecutor/Nodes/DriveExecutor/TankDriveExecutorNode/launch/tankDriveExecutor_node.launch">
                    <arg name="robot_namespace" value="$(arg robot_namespace)"/>
                    <arg name="verbosity_level"       value="$(arg verbosity_level)"/>
                    <!-- Input Topics -->
                    <arg name="topic_command_throttle" value="$(arg topic_command_throttle)"/> 

                    <!-- Output Topics -->
                    <arg name="topic_left_drive" value="$(arg topic_left_drive)"/>
                    <arg name="topic_right_drive" value="$(arg topic_right_drive)"/>
            </include>
            <include file="$(find robot_framework_ros)/Systems/BaseMachine/Subsystems/BaseMachine/Nodes/HatNodes/ServoHat/launch/ServoHat_node.launch">
                    <arg name="robot_namespace" value="$(arg robot_namespace)"/>
                    <arg name="verbosity_level"       value="$(arg verbosity_level)"/>
                    <!-- Input Topics -->
                    <arg name="topic_left_drive" value="$(arg topic_left_drive)"/>
                    <arg name="topic_right_drive" value="$(arg topic_right_drive)"/>

                    <!-- Output Topics -->
                    
            </include>
            <include file="$(find robot_framework_ros)/Systems/Pose/Subsystems/InertialSensor/Nodes/IMU/launch/IMU_node.launch">
                <arg name="robot_namespace" value="$(arg robot_namespace)"/>
                <arg name="verbosity_level"       value="$(arg verbosity_level)"/>
                <arg name="imu_frame" value="$(arg imu3_frame)" />
                <arg name="imu_device_config_file" value="$(arg imu3_device_config_file)" />

               
                <!-- Input Topics -->

                <!-- Output Topics -->
                <arg name="topic_imu" value="$(arg imu3_topic)"/>
                <arg name="topic_magnetometer" value="$(arg imu3magnetometer_topic)"/>
                    
            </include>
            <include file="$(find robot_framework_ros)/Systems/Safety/Subsystems/ModeManager/Nodes/ArmedStateManager/launch/ArmedStateManager_node.launch">
                <arg name="robot_namespace" value="$(arg robot_namespace)"/>
                <arg name="verbosity_level"       value="$(arg verbosity_level)"/>
            </include>
        </group>
    </group>
    
        
   
</launch>