<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="robot_namespace" default="/robot"/>
    <arg name="sensor_name" default="asus"/>
    <group>
        <push-ros-namespace namespace="$(var robot_namespace)"/>
        <include file="$(find-pkg-share openni2_camera)/launch/camera_with_cloud.launch.py">
            <arg name="namespace" value="$(var sensor_name)"/>
            <arg name="sensor_name" value="$(var sensor_name)"/>
        </include>
    </group>
</launch>
